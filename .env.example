# ==============================
# App
# ==============================
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# ==============================
# Database (PostgreSQL)
# ==============================
DATABASE_URL=postgres://ai-certificate-portfolio:ai-certificate-portfolio@localhost:5432/ai-certificate-portfolio?sslmode=disable

# ==============================
# Object Storage (S3/R2-compatible, MinIO)
# ==============================
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=ai-certificate-portfolio-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false

# ==============================
# Auth
# ==============================
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ==============================
# LLM
# ==============================
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=10

# ==============================
# Sentry (backend)
# ==============================
SENTRY_DSN_BACKEND=

# ==============================
# Frontend (Nuxt public runtime config)
# ==============================
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
NUXT_PUBLIC_SENTRY_DSN=
