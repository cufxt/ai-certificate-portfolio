# ==============================
# App
# ==============================
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# ==============================
# Database (PostgreSQL)
# ==============================
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ai_certificate_portfolio
DATABASE_URL=postgres://app:app@localhost:5432/ai_certificate_portfolio?sslmode=disable

# ==============================
# Object Storage (S3/R2-compatible, SeaweedFS)
# ==============================
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secret
S3_BUCKET=certificates

# ==============================
# Auth
# ==============================
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ==============================
# LLM
# ==============================
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=10

# ==============================
# Sentry (backend)
# ==============================
SENTRY_DSN_BACKEND=

# ==============================
# Frontend (Nuxt public runtime config)
# ==============================
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
NUXT_PUBLIC_SENTRY_DSN=
