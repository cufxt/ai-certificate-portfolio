# Auto detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit for common source files
*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary files — do not touch
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary

