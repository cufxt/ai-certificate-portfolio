root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# --- Go (backend) ---
[*.go]
indent_style = tab
indent_size = 4

[go.mod]
indent_style = tab

# --- Frontend (Nuxt/Vue/TS/JS) ---
[*.{js,ts,jsx,tsx,vue}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.css]
indent_style = space
indent_size = 2

# --- Markdown ---
[*.md]
trim_trailing_whitespace = false

# --- Makefile ---
[Makefile]
indent_style = tab
